document.addEventListener("DOMContentLoaded", () => {
  const menuButton = document.querySelector(".menu-toggle");
  const nav = document.querySelector(".main-nav");

  if (menuButton && nav) {
    menuButton.addEventListener("click", () => {
      const isOpen = nav.classList.toggle("open");
      menuButton.setAttribute("aria-expanded", String(isOpen));
      menuButton.textContent = isOpen ? "✕" : "☰";
    });
  }

  const drawingSearch = document.querySelector("#drawing-search");
  const drawingCategory = document.querySelector("#drawing-category");
  const drawingCards = [...document.querySelectorAll(".drawing-card")];
  const drawingEmpty = document.querySelector("#drawing-empty");
  const drawingCount = document.querySelector("#drawing-count");

  function filterDrawings() {
    const term = (drawingSearch?.value || "").trim().toLocaleLowerCase("ar");
    const category = drawingCategory?.value || "الكل";
    let shown = 0;

    drawingCards.forEach(card => {
      const text = `${card.dataset.name} ${card.dataset.artist} ${card.dataset.category}`.toLocaleLowerCase("ar");
      const matchesText = text.includes(term);
      const matchesCategory = category === "الكل" || card.dataset.category === category;
      const visible = matchesText && matchesCategory;
      card.classList.toggle("is-hidden", !visible);
      if (visible) shown++;
    });

    if (drawingEmpty) drawingEmpty.hidden = shown !== 0;
    if (drawingCount) drawingCount.textContent = `${shown} أعمال`;
  }

  drawingSearch?.addEventListener("input", filterDrawings);
  drawingCategory?.addEventListener("change", filterDrawings);

  document.querySelectorAll(".like-button").forEach(button => {
    button.addEventListener("click", () => {
      const liked = button.getAttribute("aria-pressed") === "true";
      const count = button.querySelector("span");
      const current = Number((count?.textContent || "0").replace(/[٠-٩]/g, digit => "٠١٢٣٤٥٦٧٨٩".indexOf(digit)));
      button.setAttribute("aria-pressed", String(!liked));
      button.firstChild.textContent = liked ? "♡ " : "♥ ";
      if (count) count.textContent = String(Math.max(0, current + (liked ? -1 : 1))).replace(/\d/g, digit => "٠١٢٣٤٥٦٧٨٩"[Number(digit)]);
    });
  });

  const artistSearch = document.querySelector("#artist-search");
  const artistCards = [...document.querySelectorAll(".artist-card")];
  const artistEmpty = document.querySelector("#artist-empty");
  artistSearch?.addEventListener("input", () => {
    const term = artistSearch.value.trim().toLocaleLowerCase("ar");
    let shown = 0;
    artistCards.forEach(card => {
      const matches = `${card.dataset.name} ${card.dataset.style}`.toLocaleLowerCase("ar").includes(term);
      card.classList.toggle("is-hidden", !matches);
      if (matches) shown++;
    });
    if (artistEmpty) artistEmpty.hidden = shown !== 0;
  });

  const communitySearch = document.querySelector("#community-search");
  const communityCards = [...document.querySelectorAll(".community-card")];
  const communityEmpty = document.querySelector("#community-empty");
  communitySearch?.addEventListener("input", () => {
    const term = communitySearch.value.trim().toLocaleLowerCase("ar");
    let shown = 0;
    communityCards.forEach(card => {
      const matches = card.dataset.name.toLocaleLowerCase("ar").includes(term);
      card.classList.toggle("is-hidden", !matches);
      if (matches) shown++;
    });
    if (communityEmpty) communityEmpty.hidden = shown !== 0;
  });

  document.querySelectorAll(".join-button").forEach(button => {
    button.addEventListener("click", () => {
      alert("دي نسخة تجريبية من Rivo. هنفعّل طلب الانضمام وموافقة صاحب المجتمع بعد بناء الحسابات وقاعدة البيانات.");
    });
  });

  document.querySelectorAll(".demo-action").forEach(button => {
    button.addEventListener("click", () => {
      alert("التحدي ده معروض كنموذج أولي. هنضيف المشاركة الفعلية وحفظ النتائج في مرحلة التحديات.");
    });
  });
});
